class Cuenta:
    def __init__(self, Titular, Numero_Cuenta):
        self.Titular=Titular
        self.Numero_Cuenta=Numero_Cuenta
        self.__Saldo=0
        self.Tipo_Cuenta=None

    def ObtenerInformacionBasica(self):
        return f"Titular:{self.Titular}/ N° Cuenta{self.Numero_Cuenta}"

    def ConsultarSaldo(self):
        return self.__Saldo

    def Depositar(self, monto):
        self.__Saldo+=monto

    def Girar(self, monto, LimiteSobregiro=0):
        if monto<1:
            return "El monto debe ser uno positivo"

        if self.__Saldo-monto<-LimiteSobregiro:
            return "El monto exede los fondos disponibles en el Saldo"

        self.__Saldo-=monto

    def __str__(self):
        return f"{self.Titular} {self.Numero_Cuenta}  {self.Tipo_Cuenta}"

class CuentaDeAhorro(Cuenta):
    def __init__(self, Titular, Numero_Cuenta, TasaInteres):
        super().__init__(Titular, Numero_Cuenta)
        self.Tipo_Cuenta="Ahorro"
        self.TasaInteres=TasaInteres

    def AplicarIntereses(self):
        Interes=self.ConsultarSaldo()*(self.TasaInteres/100)
        self.Depositar(Interes)

    def ObtenerInformacionBasica(self):
        info_padre=super().ObtenerInformacionBasica()
        return f"[Cuenta de Ahorro] {info_padre} / Tasa Interes {self.TasaInteres}"

class CuentaCorriente(Cuenta):
    def __init__(self, Titular, Numero_Cuenta, LimiteGiro=50000):
        super().__init__(Titular, Numero_Cuenta)
        self.Tipo_Cuenta="Corriente"
        self.LimiteGiro=LimiteGiro

    def girar(self, monto):
        super().Girar(monto, LimiteSobregiro=self.LimiteGiro)

    def ObtenerInformacionBasica(self):
        info_padre=super().ObtenerInformacionBasica()
        return f"[Cuenta Corriente] {info_padre} / Limite Giro {self.LimiteGiro}"

class Banco:
    def __init__(self, Nombre):
        self.Nombre=Nombre
        self.Cuentas=[]

    def Abrir_Cuenta(self, cuenta):
        for valor in self.Cuentas:
            if valor.Numero_Cuenta==cuenta.Numero_Cuenta:
                return "La Cuenta ya existe"
        self.Cuentas.append(cuenta)

    def BuscarCuenta(self, Numero_Cuenta):
        for cuenta in self.Cuentas:
            if cuenta.Numero_Cuenta==Numero_Cuenta:
                return cuenta
        return None

    def Transferir(self, Numero_Origen, Numero_Destino, monto):
        if monto<=0:
            return "No se puede transferir una cantidad vacia o negativa"

        Cuenta_Origen=self.BuscarCuenta(Numero_Origen)
        if Cuenta_Origen==None:
            return f"La cuenta de origen N°{Numero_Origen} no existe"

        Cuenta_Destinatario=self.BuscarCuenta(Numero_Destino)
        if Cuenta_Destinatario==None:
            return f"La cuenta del destinatario N°{Numero_Destino} no existe"

        Cuenta_Origen.Girar(monto)
        Cuenta_Destinatario.Depositar(monto)

    def Mostrar_Cuentas(self):
        if not self.Cuentas:
            return "El Banco no tiene cuentas en existencia"

        cuentas=sorted(self.Cuentas, key=lambda c: c.Numero_Cuenta)

        for cuenta in cuentas:
            print(cuenta.ObtenerInformacionBasica())

def preprocesar_cuentas(lista_cuentas):
    cuentas_limpias=[]
    numeros_registrados=set()

    for c in lista_cuentas:
        try:#esta cosa de aqui ejecuta procesos de forma continua en un orden establecido
            if "Titular" not in c or "Numero_Cuenta" not in c:
                continue
            
            titular=str(c["Titular"]).strip().title()
            if not titular:
                continue  
            
            num_cuenta=int(str(c["Numero_Cuenta"]).strip())
            if num_cuenta in numeros_registrados:
                continue  
            
            saldo_init=int(str(c.get("Saldo_Inicial", 0)).strip())
            if saldo_init<0:
                continue  
            
            tipo=str(c.get("Tipo_Cuenta", "")).strip().capitalize()
            if tipo not in ["Ahorro", "Corriente"]:
                continue
            
            registro_limpio={
                "Titular": titular,
                "Numero_Cuenta": num_cuenta,
                "Saldo_Inicial": saldo_init,
                "Tipo_Cuenta": tipo}
            
            if tipo=="Ahorro":
                try:
                    tasa=float(c.get("TasaInteres", 0.5))
                    registro_limpio["TasaInteres"]=tasa if tasa>=0 else 0.5
                except (ValueError, TypeError):
                    registro_limpio["TasaInteres"]=0.5

            elif tipo=="Corriente":
                try:
                    limite=int(c.get("LimiteGiro", 100000))
                    registro_limpio["LimiteGiro"]=limite if limite>=0 else 100000
                except (ValueError, TypeError):
                    registro_limpio["LimiteGiro"]=100000
            
            numeros_registrados.add(num_cuenta)
            cuentas_limpias.append(registro_limpio)

        except (ValueError, TypeError):
            continue

    return cuentas_limpias

